<%
  // 只保留有文字的二级、三级标题
  const items = (headings || []).filter(function (h) { return h.text && h.id; });
%>
<% if (items.length) { %>
<nav class="toc-card" id="toc" aria-label="文章目录">
  <div class="toc-head">
    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-list"></use></svg>
    <span>文章目录</span>
  </div>

  <ol class="toc-list">
    <% items.forEach(function (h) { %>
      <li class="toc-item toc-level-<%= h.level %>">
        <a class="toc-link" href="#<%= h.id %>" data-toc-target="<%= h.id %>">
          <span class="toc-bar" aria-hidden="true"></span>
          <span class="toc-text"><%= h.text %></span>
        </a>
      </li>
    <% }); %>
  </ol>
</nav>
<% } %>
