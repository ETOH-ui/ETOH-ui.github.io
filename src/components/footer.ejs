<%
  // 建站当年就只显示一个年份
  const nowYear = new Date().getFullYear();
  const yearText = site.since && site.since !== nowYear ? `${site.since}–${nowYear}` : String(nowYear);
%>
<footer id="footer">
  <div class="footer-inner">
    <p class="footer-line">
      <span>© <%= yearText %></span>
      <span class="footer-dot">·</span>
      <a href="<%= url('/about/') %>"><%= site.author %></a>
    </p>
    <p class="footer-line footer-meta">
      <a href="<%= url('/sitemap.xml') %>" target="_blank" rel="noopener">Sitemap</a>
      <% if (site.icp) { %>
        <span class="footer-dot">·</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener"><%= site.icp %></a>
      <% } %>
    </p>
  </div>
</footer>

<button id="back-to-top" type="button" aria-label="回到顶部">
  <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-arrow-up"></use></svg>
</button>
