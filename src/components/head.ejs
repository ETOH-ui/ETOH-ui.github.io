<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1b1f26" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#f5f6f8" media="(prefers-color-scheme: light)">

<%
  const siteName = site.name || site.title;
  const pageTitle = page && page.title ? `${page.title} · ${siteName}` : siteName;
  const pageDesc = (post && (post.summary || site.description)) || site.description || '';
  const canonical = absUrl(page && page.url ? page.url : '/');
  const ogImage = post && post.cover ? (post.cover.startsWith('http') ? post.cover : site.url + post.cover) : absUrl(site.banner);
%>
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDesc %>">
<meta name="author" content="<%= site.author %>">
<meta name="keywords" content="<%= (site.keywords || []).join(',') %>">
<link rel="canonical" href="<%= canonical %>">

<meta property="og:type" content="<%= page && page.type === 'post' ? 'article' : 'website' %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDesc %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:site_name" content="<%= siteName %>">
<meta property="og:image" content="<%= ogImage %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="<%= ogImage %>">

<link rel="icon" href="<%= url('/images/favicon.ico') %>" sizes="any">
<link rel="apple-touch-icon" href="<%= url('/images/apple-touch-icon.png') %>">
<link rel="manifest" href="<%= url('/site.webmanifest') %>">

<script>
  // 首屏前定好主题，避免白闪
  (function () {
    try {
      var saved = localStorage.getItem('color-mode') || '<%= theme.defaultMode %>';
      var osDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var isDark = saved === 'dark' || (saved === 'auto' && osDark);
      var root = document.documentElement;
      root.setAttribute('data-theme', isDark ? 'dark' : 'light');
      root.setAttribute('data-mode', saved);
      if (localStorage.getItem('custom-cursor') === 'off') {
        root.setAttribute('data-cursor', 'off');
      }
    } catch (e) {}
  })();
</script>

<link rel="stylesheet" href="<%= url('/css/style.css') %>">
