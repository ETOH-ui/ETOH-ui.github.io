<%
  const currentPath = page && page.url ? page.url : '/';
  const isPost = page && page.type === 'post';
  const bannerSrc = isPost && post && post.cover ? post.cover : (site.banner ? url(site.banner) : '');
  const bannerTitle = isPost ? post.title : site.title;
  const bannerSub = isPost ? '' : site.subtitle;
%>
<nav id="header-nav" aria-label="主导航">
  <div class="nav-inner">
    <div class="nav-links">
      <% nav.forEach(function (item) { %>
        <a class="nav-item<%= currentPath === item.path ? ' is-active' : '' %>" href="<%= url(item.path) %>">
          <span class="nav-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-<%= item.icon %>"></use></svg></span>
          <span class="nav-text"><%= item.name %></span>
        </a>
      <% }); %>
    </div>

    <div class="nav-actions">
      <button class="nav-icon-btn" id="search-open" type="button" aria-label="搜索 (按 / 键)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-search"></use></svg>
      </button>
      <button class="nav-icon-btn" id="mode-toggle" type="button" aria-label="切换主题">
        <svg viewBox="0 0 24 24" class="mode-icon icon-sun" aria-hidden="true"><use href="#icon-sun"></use></svg>
        <svg viewBox="0 0 24 24" class="mode-icon icon-moon" aria-hidden="true"><use href="#icon-moon"></use></svg>
        <svg viewBox="0 0 24 24" class="mode-icon icon-auto" aria-hidden="true"><use href="#icon-auto"></use></svg>
      </button>
      <button class="nav-icon-btn menu-toggle" id="menu-toggle" type="button" aria-label="打开菜单" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-menu"></use></svg>
      </button>
    </div>
  </div>
</nav>

<% if (bannerSrc) { %>
<header id="header" class="<%= isPost ? 'is-post-header' : '' %>">
  <div class="header-bg">
    <img src="<%= bannerSrc %>" alt=""<%= isPost ? '' : ' fetchpriority="high"' %>>
  </div>
  <div class="header-inner">
    <% if (isPost) { %>
      <h1 class="header-title header-title-post"><%= bannerTitle %></h1>
    <% } else { %>
      <h1 class="header-title"><%= bannerTitle %></h1>
      <% if (bannerSub) { %>
        <p class="header-subtitle"><%= bannerSub %></p>
      <% } %>
    <% } %>
  </div>
  <div class="header-scroll-hint" aria-hidden="true">
    <svg viewBox="0 0 24 24"><use href="#icon-arrow-up"></use></svg>
  </div>
</header>
<% } %>
